# Datos y Artefactos
/data/raw/*
/data/processed/*
/data/cache/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/data/cache/.gitkeep

# Ignorar todo en artifacts, EXCEPTO la carpeta eda y su contenido
/artifacts/*
!/artifacts/eda/
!/artifacts/eda/**

# Entorno / Python
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Sistema
.DS_Store

# Graphify (graphify-out/ se versiona; solo se excluye el cache)
/graphify-out/cache/
